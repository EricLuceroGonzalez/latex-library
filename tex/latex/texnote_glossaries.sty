\newglossaryentry{def-nop}{
    name={\textit{Network Operations Plan} (NOP)},
    sort={Network Operations Plan (NOP)},
    description={Principal instrumento operativo continuo elaborado por el Gestor de la Red (Eurocontrol) en colaboración con los ANSP y aerolíneas. Proporciona una visión global de la evolución prevista del tráfico aéreo y de la capacidad del espacio aéreo en Europa, abarcando desde la planificación estratégica hasta la ejecución táctica, con el fin de equilibrar la demanda y proteger a los controladores de sobrecargas de trabajo}
}

\newglossaryentry{def-adp}{
    name={\textit{ATFCM Daily Plan} (ADP)},
    sort={ATFCM Daily Plan (ADP)},
    description={Plan táctico emitido diariamente por el Gestor de la Red que detalla la capacidad disponible del espacio aéreo, la demanda prevista y las medidas específicas de Gestión de Afluencia y Capacidad (como regulaciones y escenarios de desvío) que se ejecutarán el día de las operaciones para mantener la fluidez y seguridad en la red europea}
}

\newglossaryentry{def-anm}{
    name={\textit{ATFCM Notification Message} (ANM)},
    sort={ATFCM Notification Message (ANM)},
    description={Mensaje oficial de notificación emitido por Eurocontrol el día anterior a las operaciones (fase pre-táctica o D-1). Informa a las aerolíneas, aeropuertos y centros de control sobre todas las regulaciones ATFM que estarán vigentes (por ejemplo, restricciones de capacidad en un sector específico que generarán asignación de \textit{slots} de despegue) para el día siguiente}
}

\newglossaryentry{def-inp}{
    name={\textit{Initial Network Plan} (INP)},
    sort={Initial Network Plan (INP)},
    description={Fase inicial de planificación dentro del proceso del NOP, publicada el día antes de las operaciones (D-1). Establece las expectativas preliminares de la demanda de tráfico y la capacidad disponible de los sectores antes de que se apliquen las medidas pre-tácticas finales, sirviendo como base para la toma de decisiones colaborativa (CDM) entre los actores de la aviación}
}

% TODO: Espacio aéreo
\newglossaryentry{def-cdm}{
    name={Collaborative Decision Making},
    sort={collaborative decision making},
    description={Proceso que permite que las decisiones sean tomadas por los actores que estén mejor posicionados para hacerlo, basándose en la información más completa, precisa y actualizada disponible. Se conoce por sus siglas en inglés como CDM.}
}
\newglossaryentry{def-acc}{
    name={Area Control Centre (ACC)},
    sort={Area Control Centre (ACC)},
    description={Instalación aeronáutica operativa encargada de proporcionar servicios de control de tránsito aéreo (ATC) a los vuelos en ruta dentro de una Región de Información de Vuelo (FIR) o de un Espacio Aéreo Superior (UIR). Es el entorno físico donde los controladores (ATCOs) gestionan tácticamente la separación y seguridad de las aeronaves a través de los diferentes sectores de control}
}

\newglossaryentry{def-fmp}{
    name={Posición de Gestión de Afluencia (FMP)},
    sort={Posición de Gestión de Afluencia (FP)},
    description={Unidad especializada ubicada dentro de un Centro de Control de Área (ACC) que actúa como enlace directo entre los supervisores locales y el Gestor de la Red (NM). Su misión es monitorizar continuamente la carga de tráfico de los sectores, evaluar la capacidad disponible de los ATCOs y coordinar con el NM la aplicación de medidas tácticas o pre-tácticas (regulaciones ATFM, asignación de \textit{slots}) para evitar la sobrecarga del personal de control. Conocida generalmente como \textit{Flow Management Position (FMP)}.}
}

\newglossaryentry{def-nm}{
    name={\textit{Network Manager (NM)}},
    sort={Network Manager (NM)},
    description={Entidad centralizada (función desempeñada por Eurocontrol por mandato de la Comisión Europea) responsable de gestionar el rendimiento global de la red de aviación europea. Coordina la Gestión de Afluencia del Tránsito Aéreo (ATFM) a nivel continental, elabora el Plan de Operaciones de la Red (NOP) y colabora ininterrumpidamente con las FMP locales para optimizar rutas, mitigar cuellos de botella y asegurar que la demanda global no exceda la capacidad del sistema}
}
\newglossaryentry{def-enaire}{
    name={ENAIRE},
    sort={ENAIRE},
    description={Principal Proveedor de Servicios de Navegación Aérea (ANSP) de España y entidad pública estatal encargada de la Gestión del Tránsito Aéreo (ATM) en las tres Regiones de Información de Vuelo (FIR) españolas: Madrid, Barcelona y Canarias. Como gestor directo de los recursos humanos tácticos, es el responsable de la capacitación, distribución sectorial y gestión de la carga de trabajo de los controladores de tránsito aéreo (ATCOs). A nivel operativo, sus Centros de Control (ACC) colaboran ininterrumpidamente con el Gestor de la Red (Eurocontrol) para coordinar medidas de capacidad y afluencia, garantizando un flujo seguro y equilibrado del tráfico aéreo}
}

\newglossaryentry{def-ansp}{
    name={ANSP (Air Navigation Service Provider)},
    sort={ANSP},
    description={Proveedor de Servicios de Navegación Aérea. Se refiere a las organizaciones y al personal (como controladores, ingenieros y técnicos) que se dedican a proporcionar servicios de gestión del tránsito aéreo (ATM) a los usuarios del espacio aéreo. Sus responsabilidades abarcan la planificación, inversión, implementación, operación y mantenimiento continuo de las instalaciones y sistemas CNS/ATM (Comunicaciones, Navegación, Vigilancia y Gestión del Tránsito Aéreo), así como el desarrollo de procedimientos y la capacitación. Estas organizaciones pueden adoptar diversas formas, incluyendo agencias estatales, corporaciones públicas autofinanciadas, proveedores ATM privatizados, entidades regionales o empresas independientes del sector privado.}
}
\newglossaryentry{def-fir}{
    name={región de información de vuelo (FIR)},
    sort={region de informacion de vuelo},
    description={Espacio aéreo de dimensiones definidas, dentro del cual se facilitan los servicios de información de vuelo (FIS) y de alerta (ALRS). Es la división regular de espacio aéreo más grande del mundo, y la OACI delega qué país es responsable del control operativo de una FIR determinada.}
}

\newglossaryentry{def-uir}{
    name={región superior de información de vuelo (UIR)},
    sort={region superior de informacion de vuelo},
    description={Espacio aéreo de dimensiones definidas situado por encima de una Región de Información de Vuelo (FIR). Se utiliza generalmente para gestionar el tráfico de gran altitud o en fase de crucero (como aerolíneas comerciales). El límite vertical que separa una FIR de una UIR varía según la jurisdicción de cada Estado; por ejemplo, en España la división se realiza en el nivel de vuelo FL195 (19.500 pies), mientras que en otros países europeos suele estar en el FL245.}
}
\newglossaryentry{def-cta}{
    name={\textit{Terminal Control Areas}},
    sort={\textit{Terminal Control Areas}},
    description={Área de Control. Espacio aéreo controlado que se extiende hacia arriba desde un límite especificado sobre el terreno o el agua (su límite inferior nunca es la superficie terrestre). Está diseñado para englobar y proteger las rutas ATS, garantizando la provisión del servicio de control de área a los vuelos que operan bajo reglas de vuelo por instrumentos (IFR) durante sus fases de crucero, ascenso y descenso.}
}
\newglossaryentry{def-tma}{
    name={Terminal Manoeuvring Area},
    sort={Terminal Manoeuvring Area},
    description={Área de Control Terminal. Es un tipo específico e intensivo de Área de Control (CTA) establecida normalmente en la confluencia de rutas ATS en las inmediaciones de uno o más aeródromos principales de gran afluencia. Suele diseñarse geométricamente en forma de terraza escalonada o embudo invertido. Su objetivo táctico es absorber y gestionar de manera segura la compleja transición entre los vuelos en ruta y las secuencias de aproximación y salida, concentrando habitualmente la mayor densidad de tráfico y la mayor carga cognitiva para los controladores de tránsito aéreo (ATCOs) de aproximación.}
}

\newglossaryentry{def-ruta-ats}{
    name={ruta ATS},
    sort={ruta ATS},
    plural={rutas ATS},
    description={Ruta especificada que se ha designado para canalizar la afluencia del tránsito según sea necesario para proporcionar los Servicios de Tránsito Aéreo (ATS). Es un término genérico que engloba aerovías, rutas con asesoramiento, rutas controladas o no controladas, y trayectorias estándar de llegada o salida (STAR/SID). En el contexto de la Gestión del Espacio Aéreo (ASM), el diseño de la red de rutas ATS es crítico: las intersecciones, los puntos de convergencia y los ángulos de cruce entre estas rutas determinan la complejidad de un sector y tienen un impacto directo y cuantificable en la carga cognitiva y de trabajo de los controladores de tránsito aéreo (ATCOs).}
}

\newglossaryentry{def-volumen}{
    name={volumen},
    sort={volumen},
    plural={volúmenes},
    description={Porción tridimensional del espacio aéreo definida de forma estricta por coordenadas geográficas (latitud y longitud) y límites verticales (niveles de vuelo o altitudes). En el diseño del espacio aéreo, los volúmenes son las piezas geométricas elementales o "bloques de construcción" que, agrupados de diferentes maneras, conforman los sectores de control y permiten su reconfiguración dinámica.}
}
\newglossaryentry{def-sector}{
    name={sector},
    sort={sector},
    plural={sectores},
    description={Unidad operativa básica en la que se divide un Área de Control (CTA) o un Centro de Control de Área (ACC) para facilitar la gestión táctica del tráfico aéreo. Un sector está conformado por uno o varios volúmenes de espacio aéreo y se asigna a un equipo específico de controladores (habitualmente un controlador ejecutivo y un planificador). La dimensión geométrica del sector está limitada directamente por la capacidad humana y la carga cognitiva máxima que ese equipo puede asumir con seguridad.}
}
\newglossaryentry{def-core-area}{
    name={Área Central de Europa (\textit{European Core Area})},
    sort={Area Central de Europa},
    description={Región o "núcleo" del espacio aéreo europeo que concentra la mayor densidad, complejidad e interdependencia de tráfico aéreo del continente. Geográficamente engloba el espacio aéreo del Benelux, Alemania, norte de Francia y sur del Reino Unido. Debido a su constante saturación, las restricciones de capacidad y demoras ATFM generadas en este núcleo propagan un fuerte efecto dominó hacia las regiones periféricas de la red europea.}
}
\newglossaryentry{def-sectorizacion}{
    name={sectorización},
    sort={sectorizacion},
    description={Proceso de diseño y configuración del espacio aéreo mediante el cual una Región de Información de Vuelo (FIR) o un Centro de Control de Área (ACC) se divide en porciones operativas más pequeñas denominadas sectores. El objetivo principal de la sectorización es distribuir el tráfico aéreo de manera equilibrada para garantizar que la carga de trabajo y la demanda cognitiva impuesta a los controladores de tránsito aéreo (ATCOs) se mantengan dentro de límites seguros. Este proceso puede ser estático (diseño estructural a largo plazo basado en rutas) o dinámico (reconfiguración táctica de los volúmenes en tiempo real para adaptarse a los picos de demanda diaria)}
}

\newglossaryentry{def-ejecutivo}{
    name={ejecutivo},
    sort={ejecutivo},
    plural={ejecutivos},
    description={Controlador de tránsito aéreo (ATCo) responsable de las comunicaciones tácticas directas por radio con las aeronaves dentro de un sector de control. Su función principal es emitir autorizaciones e instrucciones de rumbo (vectores radar), velocidad y altitud para mantener la separación reglamentaria y resolver conflictos a corto plazo. Soporta la carga cognitiva más exigente en tiempo real, por lo que su capacidad de procesamiento de información determina el límite de capacidad de un sector}
}
\newglossaryentry{def-planificador}{
    name={planificador},
    sort={planificador},
    plural={Controladores Planificadores},
    description={Controlador de tránsito aéreo (ATCo) que opera en tándem con el Controlador Ejecutivo dentro del mismo sector. Su labor es estratégica y a medio plazo: no se comunica rutinariamente por radio con las aeronaves, sino que analiza el tráfico entrante, coordina las transferencias con los sectores o Centros de Control (ACC) adyacentes y previene conflictos antes de que requieran una intervención táctica. Su propósito fundamental es "filtrar" el tráfico para reducir y gestionar la carga de trabajo del Controlador Ejecutivo}
}
\newglossaryentry{def-con}{
    name={acreditación CON},
    sort={acreditación CON},
    description={Controlador. En el contexto operativo y laboral español (ENAIRE), designa a los controladores de tránsito aéreo que poseen la habilitación y acreditación operativa para gestionar exclusivamente sectores de control de Área o Ruta (\textit{En-Route}). Operan habitualmente en los espacios aéreos de crucero superior (UIR) o inferior, fuera de las complejas zonas de aproximación terminal}
}
\newglossaryentry{def-ptd}{
    name={acreditación PTD},
    sort={acreditación PTD},
    description={Puesto de Trabajo Diferenciado. Categoría o acreditación operativa en el sistema de navegación aérea español (ENAIRE) que designa a los controladores capacitados y habilitados para operar tanto en sectores de ruta estándar como en sectores de Aproximación Radar (APP) y Áreas de Control Terminal (TMA). Debido a la alta densidad de tráfico, los continuos cambios de nivel (ascensos/descensos) y las convergencias de rutas en los TMA, el PTD implica un mayor nivel de exigencia técnica y carga de trabajo en comparación con un puesto CON estándar}
}


