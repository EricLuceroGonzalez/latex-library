% DESCRIPCIÓN: Configuración centralizada de Acrónimos y Glosario de Términos, 
%              con enfoque especial en definiciones ATM/ATC y OACI.
%
% ARQUITECTURA:
% - Los acrónimos puros usan su ID normal (ej. 'atm').
% - Las definiciones largas usan el prefijo 'def-' (ej. 'def-atm') para evitar 
%   redundancias en las listas impresas y conflictos de etiquetas.
%
% ------------------------------------------------------------------------------
% COMANDOS (Cheat Sheet)
% ------------------------------------------------------------------------------
% 1. USO GENERAL (Inteligente - Automático)
%    \gls{atm}       -> 1ª vez: "gestión del tránsito aéreo (ATM)" | Resto: "ATM"
%    \glspl{fir}     -> Plural: "regiones de información de vuelo (FIR)"
%    \Gls{atm}       -> Igual, pero con la primera letra en Mayúscula.
%
% 2. CONTROL MANUAL (Ignoran la memoria de LaTeX)
%    \acrshort{atm}  -> Fuerza solo la sigla: "ATM"
%    \acrlong{atm}   -> Fuerza solo el texto: "gestión del tránsito aéreo"
%    \acrfull{atm}   -> Fuerza texto + sigla: "gestión del... (ATM)"
%    *Añade 'pl' al final de estos comandos para los plurales (ej. \acrshortpl)
%
% 3. CONTROL DE GLOSARIO (Invocaciones invisibles)
%    \glsadd{def-atm}-> No imprime nada en el texto, pero añade silenciosamente 
%                       la definición larga al Glosario final.
%    \glsaddall      -> (Usar al final del doc) Añade TODOS los términos definidos.
%
% 4. IMPRESIÓN DE LISTAS (Usar en el documento principal)
%    \printglossary[type=\acronymtype, title=Lista de Acrónimos]
%    \printglossary[title=Glosario de Términos]
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texnote_glossaries}[2026/03/30 Configuración de Acrónimos y Glosario ATM]

