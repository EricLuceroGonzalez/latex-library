% 2. DEFINICIÓN DE TÉRMINOS DEL GLOSARIO
% Sintaxis: \newglossaryentry{id}{name={término}, description={significado}}
% ================================================================
\newglossaryentry{def-amc}{
    name={célula de gestión del espacio aéreo},
    sort={celula de gestion del espacio aereo},
    description={Es una célula o unidad conjunta (mixta civil y militar) encargada de llevar a cabo la gestión diaria (en fases estratégica y pretáctica) y la asignación o reserva temporal del espacio aéreo nacional. Su función es organizar este recurso en función de los requerimientos de los usuarios y las peticiones realizadas por las agencias civiles y militares aprobadas.}
}

\newglossaryentry{def-capacidad}{
    name={capacidad},
    sort={capacidad},
    description={Es el número máximo de aeronaves al que puede dar cabida el sistema, o uno de sus componentes (rendimiento o throughput), en un período de tiempo dado.}
}

\newglossaryentry{def-capacidad-acc}{
    name={capacidad del ACC},
    sort={capacidad del ACC},
    description={El número máximo teórico de vuelos que pueden entrar en un ACC o en un grupo de sectores por hora, durante un período de tiempo (ej. 3 horas), sin causar una carga de trabajo excesiva en ninguno de los sectores. Este indicador de capacidad se utiliza para fines de planificación y monitorización y carece de valor operativo directo. El indicador se calcula matemáticamente utilizando una metodología validada.}
}

\newglossaryentry{def-capacidad-declarada}{
    name={capacidad declarada del sector},
    sort={capacidad declarada del sector},
    description={El valor que el ANSP declara al NMOC como el número máximo de vuelos por hora que pueden entrar en un sector antes de que sea necesaria la aplicación de una regulación ATFM. Pueden existir varios valores, dependiendo del entorno ATC en ese momento (espacio aéreo, equipamiento, patrón de tráfico, dotación de personal, meteorología, etc.). La posición FMP define esta información y asesora al NMOC para que pueda proporcionar el servicio ATFM. El valor puede cambiar según la situación en el ACC.}
}

\newglossaryentry{def-capacidad-sector}{
    name={capacidad de sector},
    sort={capacidad de sector},
    description={El número máximo de vuelos que pueden entrar en un sector por hora, promediado a lo largo de un período de tiempo sostenible (ej. 3 horas), para garantizar un flujo de tráfico seguro, ordenado y eficiente. Algunos ANSP gestionan tácticamente las capacidades de los sectores en períodos más cortos (ej. 15 minutos). Sin embargo, para fines de evaluación global, se utiliza la cifra por hora como estándar.}
}

\newglossaryentry{def-capacidad-volumen}{
    name={capacidad declarada del volumen de tránsito},
    sort={capacidad declarada del volumen de transito},
    description={La capacidad para un período de tiempo determinado para un volumen de tránsito dado, según lo notificado por el ANSP al NMOC para que este pueda proveer el servicio ATFM. Al igual que con la capacidad de sector, el valor puede cambiar dependiendo de las condiciones del entorno ATC en ese momento en el ACC.}
}

\newglossaryentry{def-control-afluencia}{
    name={control de afluencia},
    sort={control de afluencia},
    description={Medidas encaminadas a regular el tránsito dentro de un espacio aéreo determinado, a lo largo de una ruta determinada, o con destino a un determinado aeródromo, a fin de aprovechar al máximo el espacio aéreo.}
}

\newglossaryentry{def-demanda}{
    name={demanda},
    sort={demanda},
    description={Es el número de aeronaves que solicitan utilizar el sistema de gestión del tránsito aéreo (ATM) en un período de tiempo dado.}
}

\newglossaryentry{def-asm}{
    name={gestión del espacio aéreo},
    sort={gestion del espacio aereo},
    description={Se refiere a una función de planificación cuyo objetivo principal es maximizar la utilización del espacio aéreo disponible mediante la asignación dinámica del tiempo y, en ocasiones, la segregación del espacio aéreo entre diversas categorías de usuarios en función de sus necesidades a corto plazo.}
}

\newglossaryentry{def-atfm}{
    name={gestión de la afluencia del tránsito aéreo},
    sort={gestion de la afluencia del transito aereo},
    description={Servicio establecido con el objetivo de contribuir a una circulación segura, ordenada y expedita del tránsito aéreo asegurando que se utiliza al máximo posible la capacidad ATC, y que el volumen de tránsito es compatible con las capacidades declaradas por la autoridad ATS competente.}
}

\newglossaryentry{def-atfcm}{
    name={gestión de la afluencia y capacidad del tránsito aéreo},
    sort={gestion de la afluencia y capacidad del transito aereo},
    description={Servicio que tiene como objetivo mejorar la seguridad, la eficiencia y la sostenibilidad ambiental del sistema ATM optimizando los flujos de tráfico de acuerdo con la capacidad disponible del control de tráfico aéreo (ATC), al mismo tiempo que se optimiza dicha capacidad para que coincida con la demanda esperada.}
}

\newglossaryentry{def-atm}{
    name={gestión del tránsito aéreo},
    sort={gestion del transito aereo},
    description={Administración dinámica e integrada — segura, económica y eficiente — del tránsito aéreo y del espacio aéreo, que incluye los servicios de tránsito aéreo, la gestión del espacio aéreo y la gestión de la afluencia del tránsito aéreo, mediante el suministro de instalaciones y servicios sin discontinuidades en colaboración con todos los interesados y funciones de a bordo y basadas en tierra.}
}

\newglossaryentry{heuristica}{
    name={heurística},
    sort={heuristica},
    description={Método de resolución de problemas de optimización que sacrifica la garantía de encontrar la solución matemática perfecta a cambio de encontrar una solución "suficientemente buena" en un tiempo computacional razonable.}
}

\newglossaryentry{metaheuristica}{
    name={metaheurística},
    sort={metaheuristica},
    plural={metaheurísticas},
    description={Método de resolución de problemas de optimización que sacrifica la garantía de encontrar la solución matemática perfecta a cambio de encontrar una solución "suficientemente buena" en un tiempo computacional razonable.}
}

\newglossaryentry{def-saturacion}{
    name={saturación},
    sort={saturacion},
    description={Franjas de tiempo en las que la demanda de tráfico aéreo es mayor a la capacidad declarada en un sector determinado.}
}

\newglossaryentry{def-sector-afin}{
    name={sector afín},
    sort={sector afin},
    plural={sectores afines},
    description={Dos sectores se denominan afines si poseen algún volumen espacial en común.}
}

\newglossaryentry{sector}{
    name={sector de control},
    sort={sector de control},
    description={Volumen específico de espacio aéreo en el cual un controlador aéreo (ATCO) o un equipo de controladores es responsable de gestionar el tráfico.}
}

\newglossaryentry{def-sector-elemental}{
    name={sector elemental},
    sort={sector elemental},
    plural={sectores elementales},
    description={Componente primario de la estructura del espacio aéreo. Se pueden combinar uno o más de ellos para formar un sector operativo. En algunos casos, el sector elemental puede coincidir con el sector operativo; en otros, un sector elemental nunca se abre operativamente sin combinarse con uno o más sectores elementales adicionales.}
}

\newglossaryentry{def-atco}{
    name={controlador de tráfico aéreo (ATCO)},
    plural={controladores de tráfico aéreo},
    sort={controlador de trafico aereo},
    description={personal que suministra el servicio de control de tráfico con el fin de prevenir colisiones y  acelerar y mantener ordenadamente el movimiento del tránsito aéreo.}
}
\newglossaryentry{def-atcs}{
    name={servicio de control del tráfico aéreo},
    sort={servicio de control del trafico aereo},
    description={Servicio a las naves en vuelo o los aeródromos con la finalidad de prevenir colisiones y agilizar la afluencia del tránsito aéreo de forma ordenada y segura.}
}

\newglossaryentry{def-ats}{
    name={servicio de tránsito aéreo},
    sort={servicio de transito aereo},
    plural={servicios de tránsito aéreo},
    description={Expresión genérica que se aplica, según el caso, a los servicios de información de vuelo, alerta, asesoramiento de tránsito aéreo, control de tránsito aéreo (servicios de control de área, control de aproximación o control de aeródromo).}
}

\newglossaryentry{def-slot-atfm}{
    name={\textit{slot}},
    plural={\textit{slots}},
    sort={slot},
    description={Hora calculada de despegue (CTOT) asignada centralmente por el Gestor de la Red (ej. Eurocontrol) para regular el flujo de tráfico cuando la demanda excede la capacidad. Otorga a la aeronave una ventana de tolerancia específica (estándar de -5 a +10 minutos respecto al CTOT) dentro de la cual debe despegar obligatoriamente para garantizar la seguridad y fluidez del sistema ATM.}
}

\newglossaryentry{def-gat}{
    name={tránsito aéreo general},
    sort={transito aereo general},
    description={Se refiere a los vuelos (generalmente civiles) que operan bajo las reglas y procedimientos estándar de tránsito aéreo.}
}

\newglossaryentry{def-oat}{
    name={tránsito aéreo operativo},
    sort={transito aereo operativo},
    description={Hace referencia a las operaciones de vuelo (generalmente militares o de estado) que interactúan en el espacio aéreo compartido.}
}

\newglossaryentry{def-volumen-transito}{
    name={volumen de tránsito},
    sort={volumen de transito},
    description={Componente del espacio aéreo basado en los flujos de tráfico, el cual sirve como referencia para el diseño de los sectores ATC.}
}

