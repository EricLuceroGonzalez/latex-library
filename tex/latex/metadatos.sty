% ================================================================
% @author: Eric Lucero
% @description: Configuración de metadatos y comportamiento del visor PDF
% ================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texnote_metadata}[2026/02/25 Metadatos automaticos para el PDF]

% Asegurarnos de que hyperref esté cargado antes de inyectar metadatos
\RequirePackage{hyperref}

\makeatletter
\AtBeginDocument{
    \hypersetup{
        % --- Metadatos del PDF (Automático) ---
        % pdftitle={\@title},                     % Usa el título definido en \title{}
        pdftitle={Dossier de Solvencia y Perfil - Alquiler Madrid},
        pdfauthor={Eric Lucero Gonzalez},       % Usa el autor definido en \author{}
        pdfcreator={pdftex},                    % Creador del documento
        pdfsubject={Tesis Doctoral / Proyecto}, % Asunto genérico
        % pdfkeywords={LaTeX, Tesis, UPM, AI, PhD},% Palabras clave
        pdfkeywords={Confidencial, Datos Personales, NoAI, NoML, do-not-scrape, private},
        pdfdisplaydoctitle=true,                % Muestra el título en la barra de ventana
        pdfproducer={Texmaker, TexLive, MacOS}, % Productor del documento

        % --- Comportamiento de Apertura ---
        bookmarksnumbered=true, % Incluye números en los marcadores del PDF
        bookmarksopen=true,     % Abre el árbol de marcadores al iniciar
        bookmarksopenlevel=1,   % Nivel de profundidad al abrir (1 = Capítulos)
        pdfpagemode=UseOutlines,% Muestra los marcadores al abrir el PDF
        pdfstartview=FitH       % Abre el PDF ajustado al ancho de página
    }
}
\makeatother

\endinput