\endinput

% ================================================================
%  GUÍA RÁPIDA DE USO EN EL TEXTO:
% ================================================================
% \ac{atm}  -> Uso estándar: Imprime "Nombre Completo (SIGLA)" la primera vez, 
%              y solo "SIGLA" todas las veces posteriores.
% \acp{atm} -> Uso plural: Igual que el anterior, pero aplica automáticamente 
%              las terminaciones en plural (ej. ATCOs).
% \acf{atm} -> Forzar completo (Full): Imprime SIEMPRE "Nombre Completo (SIGLA)", 
%              sin importar si ya se ha mencionado antes en el texto.
% \acs{atm} -> Forzar corto (Short): Imprime SIEMPRE únicamente la "SIGLA", 
%              ideal para títulos, tablas o figuras donde no hay espacio.
%
% Comando para imprimir la lista (poner después del índice):
% \printacronyms[name=Lista de Acrónimos]
% ================================================================