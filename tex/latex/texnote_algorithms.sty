% ----- Paleta ----------------------------------------------------------------
\definecolor{kwBlue}   {RGB}{ 31,119,180}
\definecolor{commGray} {RGB}{100,100,100}
\definecolor{raiseRed} {RGB}{180, 39, 40}

% ----- Estilos de algorithm2e (un macro de un argumento) ---------------------
\newcommand{\KwColorSty}[1]{\textcolor{kwBlue}{\textbf{#1}}}
\newcommand{\CommColorSty}[1]{\textcolor{GithubRed}{\textit{#1}}}
\SetKwSty{KwColorSty}
\SetCommentSty{CommColorSty}

% ----- Etiquetas de entrada / salida -----------------------------------------
% Con la opcion `spanish`, \KwIn/\KwOut/\KwData/\KwResult ya salen como
% Entrada/Salida/Datos/Resultado. Mantenemos alias en espanol propios
% (\KwDatos/\KwResultado) y una etiqueta que NO es estandar (\KwEstado).
\SetKwInput{KwIn}{Entrada}        % redundante con `spanish`, se deja por robustez
\SetKwInput{KwOut}{Salida}        % idem
\SetKwInput{KwDatos}{Datos}
\SetKwInput{KwResultado}{Resultado}
\SetKwInput{KwEstado}{Estado interno}

% ----- Palabras clave de control ---------------------------------------------
\SetKw{Continue}{continue}
\SetKw{Break}{break}
\SetKw{KwY}{y}
\SetKw{KwO}{o}

% ----- Excepciones (una sola macro; antes habia \Raise y \KWraise) -----------
