\tikzset{
    bicolor polygon/.pic = {
            \node[regular polygon, regular polygon sides=#1,
                minimum size=4cm, draw, fill=blue!50,
                outer sep=0pt] at (0,0) (-node){};
            \foreach \i in {1,2,...,#1}
            \draw[fill=blue!25] (-node.corner \i)
            --(-node.side \i)--(-node.center)--cycle;
        }}


