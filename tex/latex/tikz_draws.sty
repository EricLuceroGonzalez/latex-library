% Descripción: Este archivo define las librerías y formatos tikz-tcolorbox-pgfplots utilizados en los documentos de LaTeX.
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TikZ_Draws}

% Gráficos y diseño
\RequirePackage{tikz, pgfplots, xcolor, adjustbox}
\usetikzlibrary{shadings, angles, quotes, shapes, chains, mindmap, trees,
backgrounds, shapes.geometric, arrows, arrows.meta, calc,
plotmarks, intersections, shadows.blur, decorations.markings, decorations.pathreplacing,
patterns, decorations.pathmorphing, matrix, positioning, babel,scopes
}

\usetikzlibrary{ext.positioning-plus, ext.node-families, ext.paths.ortho}
% \tikzextset{compat/positioning-plus = pre 0.6}   % <-- alinea el comportamiento con el ejemplo

\RequirePackage{pgfplotstable, pgf-pie}  % Librerías de gráficos para TikZ; genera gráficos de funciones, datos tabulados y gráficos de torta.
\pgfplotsset{compat=1.18}  % Configura la compatibilidad de pgfplots para asegurar estabilidad.
\RequirePackage{forest}  % Facilita la creación de árboles (como diagramas jerárquicos o familiares) usando TikZ.
\RequirePackage{smartdiagram}  % Crea diagramas simples (como flujos de trabajo, listas de pasos, etc.).
\tcbuselibrary{skins,breakable}  % Librerías adicionales para ajustar el estilo y el comportamiento de tcolorbox.
\RequirePackage{layouts}
% \RequirePackage{tcolorbox}  % Crea cajas de contenido personalizables, ideal para resaltar partes del documento.

% Configuración global para TikZ para usar la sans-serif en los diagramas, manteniendo el texto principal con serifas.
\tikzset{
    % El lienzo general usará la familia sin remates (Plex)
    every picture/.append style={
            font=\sffamily
        },
    % Forzamos a que CADA nodo (incluso los que van en \draw) respete esta regla
    every node/.append style={
            font=\sffamily
        }
}