% ================================================================
% @author: Eric Lucero
% @description: Configuración de metadatos y comportamiento del visor PDF
% ================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texnote_metadata}

% Es recomendable asegurar que hyperref esté cargado antes de configurarlo
\RequirePackage{hyperref}

\makeatletter
% Hook moderno que se ejecuta ANTES de que hyperref cierre el diccionario
\AddToHook{begindocument/before}{
    \hypersetup{
        % --- Metadatos del PDF (Automático) ---
        pdftitle={\@title},
        pdfauthor={\@author},                   % Toma el autor definido en \author{}
        pdfsubject={Tesis Doctoral},
        pdfdisplaydoctitle=true,
        pdfproducer={pdftex, TexLive, MacOS},
        pdfcreator={\@author},                  % Sobrescribe "LaTeX with hyperref"
        % --- Comportamiento de Apertura ---
        bookmarksnumbered=true,
        bookmarksopen=true,
        bookmarksopenlevel=1,
        pdfpagemode=UseOutlines,
        pdfstartview=FitH
    }
}
\makeatother

\endinput